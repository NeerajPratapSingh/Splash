{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Splash",
  "version": "0.2.0",
  "identifier": "com.neeraj.splash",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Splash",
        "width": 1200,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Neeraj Pratap Singh",
    "copyright": "Copyright © 2026 Neeraj Pratap Singh. MIT License.",
    "category": "Utility",
    "shortDescription": "A fast, lightweight file explorer for Windows",
    "longDescription": "Splash is a fast, lightweight file explorer for Windows with tabs, split view, drag and drop, photo previews, archives and the full right-click menu.",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
